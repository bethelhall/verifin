{
  "schema_version": "1.0",
  "policy_id": "verifin-paper-scoring-v1",
  "status": "publication-template",
  "datasets": {
    "xbrlfiling": {
      "display_name": "XBRLFiling",
      "source_path": "data/multicompany_provable/data/provable_calcrequired.jsonl",
      "id_field": "financebench_id",
      "denominator": 600,
      "excluded_ids": []
    },
    "financebench": {
      "display_name": "FinanceBench",
      "source_path": "data/numerical_questions.jsonl",
      "id_field": "financebench_id",
      "denominator": 67,
      "excluded_ids": []
    }
  },
  "candidate_correctness": {
    "claimed_value_field": "claimed_value",
    "gold_text_fields_in_priority_order": [
      "gold_answer",
      "answer"
    ],
    "numeric_token_pattern": "-?\\d[\\d,]*\\.?\\d*",
    "compare_magnitudes": true,
    "match_rule": "abs(abs(claimed_value) - abs(gold_value)) <= max(1.0, 0.01 * abs(gold_value))",
    "match_any_gold_numeric_token": true,
    "manual_adjudications": "manual_adjudications.json",
    "manual_adjudication_rule": "For a listed question, compare the candidate only with that question's allowed_targets using the target's tolerance. Never classify an arbitrary candidate as correct solely because its ID is listed.",
    "manual_adjudication_note": "These FinanceBench cases require explicit unit, composite-answer, or task-normalization handling. The audit file records the candidate-specific targets and caveats."
  },
  "outcome_mapping": {
    "TA": "claimed_value is present, status is VERIFIED, and candidate is correct",
    "FA": "claimed_value is present, status is VERIFIED, and candidate is incorrect",
    "TR": "claimed_value is present, status is VIOLATED, and candidate is incorrect",
    "FR": "claimed_value is present, status is VIOLATED, and candidate is correct",
    "AB": "claimed_value is null or status is not VERIFIED or VIOLATED"
  },
  "metrics": {
    "precision": "TA / (TA + FA)",
    "decision_accuracy": "(TA + TR) / (TA + FA + TR + FR)",
    "coverage": "(TA + FA + TR + FR) / dataset_denominator",
    "abstention": "AB / dataset_denominator",
    "false_accept_count": "FA"
  },
  "smt_selection": {
    "relative_path_template": "smt/{id}_{status}.smt2",
    "one_file_per_result_row": true,
    "require_exists": true,
    "require_nonempty": true,
    "ignore_stale_status_named_files": true
  },
  "baseline_protocol": {
    "name": "one-pool shared-answer evaluation",
    "answer_generator_run_by_dataset": {
      "xbrlfiling": "results/mc_calc_detsmt_v2_haiku/results.jsonl",
      "financebench": "results/fb_detsmt_v2_haiku/results.jsonl"
    },
    "shared_field": "raw_answer",
    "shared_field_matches_all_rows": true,
    "claimed_value_note": "The baseline runner reparses the shared raw_answer text, so a baseline claimed_value can differ from the answers-from artifact even though the generated answer text is identical.",
    "evaluator_model": "claude-haiku-4-5-20251001",
    "result_root": "results/onepool"
  },
